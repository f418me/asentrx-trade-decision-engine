# --- General Application Settings ---
LOG_LEVEL_CONSOLE=INFO
PROD_EXECUTION=False
SENTRY_DSN=
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=local

# --- Twilio SMS Notifications ---
SMS_NOTIFICATIONS_ENABLED=False
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15017122661
TWILIO_TO_NUMBER=+15558675310

# --- Bitfinex API Credentials ---
BFX_API_KEY=YOUR_BITFINEX_API_KEY
BFX_API_SECRET=YOUR_BITFINEX_API_SECRET
TRADE_SYMBOL=tBTCF0:USTF0 # Example: Bitcoin Perpetual Futures

# --- AI Model Settings ---
#OpenAI API Key
OPENAI_API_KEY=


#Groq API Key
GROQ_API_KEY=


# Google Gemini API Key
GEMINI_API_KEY=

#Model according to the LLM provider
#MODEL=groq:llama-3.3-70b-versatile
MODEL=openai:gpt-5.4
#MODEL=openai:gpt-5-mini
#MODEL=google-gla:gemini-2.5-pro-preview-05-06
#MODEL=google-gla:gemini-2.5-flash-preview-05-20

# --- FED Decision Specific Order Amounts ---
# Positive values open/increase long exposure; negative values open/increase short exposure.
# FED signals are usually scheduled and cleaner than Truth Social signals, so their sizing can be higher.
ORDER_AMOUNT_FED_BUY_HIGH_CONF=0.002
ORDER_AMOUNT_FED_SHORT_HIGH_CONF=-0.002
ORDER_AMOUNT_FED_BUY_MED_CONF=0.001
ORDER_AMOUNT_FED_SHORT_MED_CONF=-0.001

# --- FED Decision Specific Leverage Settings ---
LEVERAGE_FED_BUY_HIGH_CONF=20
LEVERAGE_FED_SHORT_HIGH_CONF=20
LEVERAGE_FED_BUY_MED_CONF=10
LEVERAGE_FED_SHORT_MED_CONF=10

# --- FED Decision Specific Confidence Thresholds for Trading ---
CONFIDENCE_THRESHOLD_FED_HIGH=0.90 # True rate-decision surprises should clear this; clear narrative deviations should usually fall just below or around it
CONFIDENCE_THRESHOLD_FED_MED=0.85

# --- Truth Social Broad-Market Order Amounts ---
# Used for broad-market BTC impact signals such as tariffs, fiscal policy, Fed pressure, or geopolitical risk.
# Suggested starting point: keep these smaller than FED trades because posts are noisier and can reverse quickly.
TS_ORDER_AMOUNT_BUY_HIGH_CONF=0.0008
TS_ORDER_AMOUNT_SHORT_HIGH_CONF=-0.0008
TS_ORDER_AMOUNT_BUY_MED_CONF=0.0004
TS_ORDER_AMOUNT_SHORT_MED_CONF=-0.0004

# --- Truth Social Broad-Market Leverage Settings ---
# Conservative defaults for headline-driven trades. Raise only after dry-run/backtest review.
TS_LEVERAGE_BUY_HIGH_CONF=5
TS_LEVERAGE_SHORT_HIGH_CONF=5
TS_LEVERAGE_BUY_MED_CONF=3
TS_LEVERAGE_SHORT_MED_CONF=3

# --- Truth Social Bitcoin/Crypto-Specific Order Amounts ---
# Used when the signal is directly BTC/crypto-policy related.
TS_ORDER_AMOUNT_BITCOIN_BUY_HIGH_CONF=0.001
TS_ORDER_AMOUNT_BITCOIN_SHORT_HIGH_CONF=-0.001
TS_ORDER_AMOUNT_BITCOIN_BUY_MED_CONF=0.0005
TS_ORDER_AMOUNT_BITCOIN_SHORT_MED_CONF=-0.0005

# --- Truth Social Bitcoin/Crypto-Specific Leverage Settings ---
TS_LEVERAGE_BITCOIN_BUY_HIGH_CONF=6
TS_LEVERAGE_BITCOIN_SHORT_HIGH_CONF=6
TS_LEVERAGE_BITCOIN_BUY_MED_CONF=3
TS_LEVERAGE_BITCOIN_SHORT_MED_CONF=3

# --- Truth Social Confidence Thresholds ---
# Broad-market signals need especially high confidence because tariff/geopolitical headlines can be noisy.
TS_CONFIDENCE_THRESHOLD_HIGH=0.97
TS_CONFIDENCE_THRESHOLD_MED=0.94

# Direct BTC/crypto-policy signals can use slightly lower thresholds, but should still be strict.
TS_CONFIDENCE_THRESHOLD_BITCOIN_HIGH=0.96
TS_CONFIDENCE_THRESHOLD_BITCOIN_MED=0.92

# --- Truth Social Signal Quality Gates ---
# Novelty protects against trading repeated slogans or already-priced-in policy positions.
TS_MIN_NOVELTY_SCORE=0.80

# Only immediate/same-day catalysts are eligible for automatic trades.
# Valid values from the agent: immediate, same_day, slow, none
TS_ALLOWED_TIME_SENSITIVITIES=immediate,same_day

# --- Limit Offsets ---
# Trader class applies: BUY_LIMIT = PRICE * (1 + OFFSET), SHORT_LIMIT = PRICE * (1 - OFFSET)
LIMIT_OFFSET_BUY=0.005
LIMIT_OFFSET_SHORT=0.005

# --- Web Monitor Specific (for asentrx-web-monitor client) ---
# These are used by the external client, not by this engine.
# MONITOR_BASE_URL="https://www.federalreserve.gov"
# MONITOR_MAIN_PAGE_PATH="/monetarypolicy/fomccalendars.htm"
# MONITOR_INTERVAL_SECONDS="300"
# MONITOR_RECENT_ARTICLES_COUNT="5"
# MONITOR_KEYWORD=""
# MONITOR_TITLE_KEYWORD="Federal Open Market Committee"
